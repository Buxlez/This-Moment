# Runs the full product flow with a deterministic local catalog when live
# services are not configured. Set to false to require live services.
DEMO_MODE=true
PORT=8080

# TTS provider. Credentials stay on the server; missing credentials degrade to
# text-only recommendation copy with a manual retry control.
TTS_PROVIDER=volcengine
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# Optional alternative authentication:
VOLCENGINE_TTS_API_KEY=
# Legacy dual-header authentication requires both values below.
# VOLCENGINE_TTS_SECRET_KEY is not used; do not configure it.
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE_TYPE=zh_female_vv_uranus_bigtts
VOLCENGINE_TTS_FORMAT=mp3
VOLCENGINE_TTS_SAMPLE_RATE=24000

# Music provider.
NETEASE_AUTO_START=true
NETEASE_LOGIN_BOOTSTRAP=true
NETEASE_API_BASE=http://127.0.0.1:3000
NETEASE_LEVEL=standard
NETEASE_COOKIE=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
